{
  "name": "crushd-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Crushd - Gamified Dating App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker-compose up -d",
    "db:init": "tsx src/scripts/initDatabase.ts",
    "db:seed": "tsx src/scripts/seedDatabase.ts",
    "test:users": "tsx src/scripts/testUsers.ts",
    "db:clear:hard": "tsx src/scripts/clearDatabase.ts --force --verbose",
    "db:clear:safe": "tsx src/scripts/clearDatabase.ts",
    "setup": "npm run db:start && sleep 5 && npm run db:init && npm run db:seed",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "tsc": "tsc"
  },
  "keywords": [
    "dating",
    "app",
    "backend",
    "api",
    "nodejs",
    "typescript"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "nodemon": "^3.0.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
